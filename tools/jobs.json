 },
 {
  "key": "rex-33d0f53c",
  "text": "Pow!",
  "v": "rex"
 },
 {
  "key": "rex-c2aac61f",
  "text": "Glitch the space slime eats words and trapped our friends! Fly to each planet and read to save them!",
  "v": "rex"
 },
 {
  "key": "rex-6865487d",
  "text": "You saved everyone. Our crew is home!",
  "v": "rex"
 },
 {
  "key": "rex-361fca81",
  "text": "Power full! Next, the radar!",
  "v": "rex"
 },
 {
  "key": "rex-d94a29ec",
  "text": "Radar locked on! Now let’s fix the rocket.",
  "v": "rex"
 },
 {
  "key": "rex-bcf8d948",
  "text": "Rocket fixed! Engines on! Time to face Glitch!",
  "v": "rex"
 },
 {
  "key": "rex-49311533",
  "text": "Read it out loud to a grown-up, then fire!",
  "v": "rex"
 },
 {
  "key": "rex-a81c261a",
  "text": "Don’t listen to him! Tap Sound it out, then fire again.",
  "v": "rex"
 },
 {
  "key": "rex-c2226be0",
  "text": "I didn’t hear you, Captain! Tap the button and say it nice and loud!",
  "v": "rex"
 },
 {
  "key": "rex-dc6c4fbc",
  "text": "Good try! Let’s ask a grown-up.",
  "v": "rex"
 },
 {
  "key": "rex-e46901cb",
  "text": "The radar picked up a sound! Which letter is it?",
  "v": "rex"
 },
 {
  "key": "rex-7e62c5bc",
  "text": "The radar picked up a word! Find it!",
  "v": "rex"
 },
 {
  "key": "rex-550231f3",
  "text": "The radar picked up a message! Find it!",
  "v": "rex"
 },
 {
  "key": "rex-b4fedae1",
  "text": "The rocket broke! Listen, then build the word to fix it!",
  "v": "rex"
 },
 {
  "key": "rex-bd3264e8",
  "text": "The rocket broke! Put the words back in order!",
  "v": "rex"
 },
 {
  "key": "rex-70040ecf",
  "text": "Glitch is here! Sound out the word, then read it out loud to fire!",
  "v": "rex"
 },
 {
  "key": "rex-3a9cdb5b",
  "text": "Glitch is here! Read the sentence out loud to fire your laser!",
  "v": "rex"
 },
 {
  "key": "rex-fcb0aaa4",
  "text": "Now say it fast, all together, and FIRE!",
  "v": "rex"
 },
 {
  "key": "rex-dca7b49c",
  "text": "Now read the whole sentence and FIRE!",
  "v": "rex"
 },
 {
  "key": "rex-299d9959",
  "text": "1 friend rescued. Let’s save the rest!",
  "v": "rex"
 },
 {
