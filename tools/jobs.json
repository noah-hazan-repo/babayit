 {
  "key": "rex-3064096a",
  "text": "Glitch is gone! Lev is free!",
  "v": "rex"
 },
 {
  "key": "rex-13afdec2",
  "text": "Lev joined your crew! coal ha-kah-vode, Captain May-eer!",
  "v": "rex"
 },
 {
  "key": "rex-d47c3390",
  "text": "Glitch trapped Turbo on Planet gahn! We have to save him, Captain May-eer!",
  "v": "rex"
 },
 {
  "key": "rex-91e66c42",
  "text": "Hey May-eer, you’re probably in gahn now, right? I bet they speak a lot of Hebrew there. Let’s power up two English sounds!",
  "v": "rex"
